{
  "name": "dsh-account-meter",
  "version": "0.1.2",
  "description": "DeepSeek Harness (dsh) 右侧账户计量小框：多账户（DeepSeek / Kimi 等）余额 + DSH 内消费统计，当前接入账户高亮，消费口径标注「DSH 消耗」，设置页可视化账户配置。A right-side account meter for the DeepSeek Harness Web GUI: per-provider balance, DSH-local spend, active-account highlight and a visual account editor.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "balance",
    "usage",
    "account",
    "kimi",
    "moonshot",
    "web",
    "cost",
    "meter"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/54singa/dsh-account-meter.git"
  },
  "bugs": {
    "url": "https://github.com/54singa/dsh-account-meter/issues"
  },
  "homepage": "https://github.com/54singa/dsh-account-meter#readme"
}
